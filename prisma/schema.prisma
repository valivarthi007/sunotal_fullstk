datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ADMIN
  VENDOR
  DRIVER
}

enum OrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id            Int           @id @default(autoincrement())
  name          String
  email         String        @unique
  passwordHash  String        @map("password_hash")
  role          Role          @default(CUSTOMER)
  phone         String?
  city          String?
  active        Boolean       @default(true)
  walletBalance Decimal       @default(500.00) @map("wallet_balance") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  orders        Order[]
  addresses     UserAddress[]
  ratings       Rating[]
  wishlists     Wishlist[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Vendor {
  id                Int         @id @default(autoincrement())
  name              String
  vendorName        String?     @map("vendor_name")
  firstName         String?     @map("first_name")
  lastName          String?     @map("last_name")
  email             String?     @unique
  phone             String?
  category          String      @default("Fresh Produce")
  address           String?
  city              String?
  location          String?
  produce           String?     @default("Fresh Produce")
  farmSize          String?     @default("5 Acres") @map("farm_size")
  aadhar            String?
  gstin             String?
  status            String      @default("approved")
  active            Boolean     @default(true)
  notes             String?
  bankName          String?     @default("State Bank of India") @map("bank_name")
  accountNumber     String?     @default("30987654321") @map("account_number")
  ifscCode          String?     @default("SBIN0004123") @map("ifsc_code")
  branchName        String?     @default("Main Agricultural Branch") @map("branch_name")
  accountHolderName String?     @map("account_holder_name")
  upiId             String?     @map("upi_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  quotations        Quotation[]
  inventoryItems    Inventory[]

  @@index([email])
  @@index([phone])
  @@index([category])
  @@index([status])
  @@map("vendors")
}

model Warehouse {
  id                   Int      @id @default(autoincrement())
  name                 String
  address              String
  city                 String
  latitude             Decimal? @default(12.9716) @db.Decimal(10, 6)
  longitude            Decimal? @default(77.5946) @db.Decimal(10, 6)
  freeDeliveryRadiusKm Decimal? @default(30.00) @map("free_delivery_radius_km") @db.Decimal(5, 2)
  maxServiceRadiusKm   Decimal? @default(70.00) @map("max_service_radius_km") @db.Decimal(5, 2)
  baseDeliveryFee      Decimal? @default(50.00) @map("base_delivery_fee") @db.Decimal(10, 2)
  perKmRate            Decimal? @default(8.00) @map("per_km_rate") @db.Decimal(10, 2)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  orders               Order[]

  @@index([city])
  @@index([isActive])
  @@map("warehouses")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  icon      String?  @default("📦")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("categories")
}

model ProductDefinition {
  id          Int      @id @default(autoincrement())
  name        String
  category    String
  defaultUnit String?  @default("1 kg") @map("default_unit")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("product_definitions")
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String
  subtitle  String?
  image     String
  link      String?  @default("/products")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([active])
  @@map("banners")
}

model Product {
  id             Int         @id @default(autoincrement())
  name           String
  category       String
  price          Decimal     @db.Decimal(10, 2)
  originalPrice  Decimal?    @map("original_price") @db.Decimal(10, 2)
  unit           String?     @default("1 kg")
  image          String?
  isOrganic      Boolean     @default(true) @map("is_organic")
  stock          Int         @default(100)
  rating         Decimal?    @default(4.80) @db.Decimal(3, 2)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  orderItems     OrderItem[]
  wishlists      Wishlist[]
  inventoryItems Inventory[]

  @@index([category])
  @@index([name])
  @@index([active])
  @@map("products")
}

model Quotation {
  id                  Int      @id @default(autoincrement())
  vendorId            String?  @map("vendor_id")
  vendorName          String   @map("vendor_name")
  produce             String
  cropName            String?  @map("crop_name")
  quantity            Decimal  @db.Decimal(10, 2)
  price               Decimal  @db.Decimal(10, 2)
  category            String?  @default("Vegetables")
  unit                String?  @default("Quintal")
  qualityGrade        String?  @default("Grade A (Organic / Premium)") @map("quality_grade")
  expectedHarvestDate String?  @map("expected_harvest_date")
  darkStoreAllocation String?  @default("Vijayawada Central Hub") @map("dark_store_allocation")
  notes               String?
  phone               String?
  address             String?
  status              String   @default("pending")
  paymentStatus       String?  @default("processing") @map("payment_status")
  invoiceGenerated    Boolean? @default(false) @map("invoice_generated")
  invoiceNumber       String?  @map("invoice_number")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  vendorRef   Vendor? @relation(fields: [vendorIntId], references: [id])
  vendorIntId Int?    @map("vendor_int_id")

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
  @@map("quotations")
}

model Order {
  id             Int         @id @default(autoincrement())
  orderNumber    String      @unique @map("order_number")
  userId         Int?        @map("user_id")
  userName       String?     @map("user_name")
  userPhone      String?     @map("user_phone")
  address        String?
  city           String?
  totalAmount    Decimal     @map("total_amount") @db.Decimal(10, 2)
  discountAmount Decimal?    @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal     @map("final_amount") @db.Decimal(10, 2)
  deliveryFee    Decimal?    @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  status         OrderStatus @default(PLACED)
  paymentStatus  String?     @default("paid") @map("payment_status")
  paymentMethod  String?     @default("UPI / Wallet") @map("payment_method")
  warehouseId    Int?        @map("warehouse_id")
  createdAt      DateTime    @default(now()) @map("created_at")

  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  warehouse Warehouse?  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  ratings   Rating[]

  @@index([userId])
  @@index([status])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int      @map("order_id")
  productId   Int      @map("product_id")
  productName String   @map("product_name")
  unit        String?
  image       String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  totalPrice  Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Rider {
  id        Int           @id @default(autoincrement())
  riderId   String?       @unique @map("rider_id")
  name      String
  phone     String        @unique
  email     String?
  upiId     String?       @map("upi_id")
  status    String        @default("AVAILABLE")
  lat       Float?
  lng       Float?
  createdAt DateTime      @default(now()) @map("created_at")
  payouts   RiderPayout[]
  ratings   Rating[]

  @@index([status])
  @@index([phone])
  @@map("riders")
}

model RiderPayout {
  id             Int      @id @default(autoincrement())
  riderId        String?  @map("rider_id")
  riderName      String   @map("rider_name")
  phone          String?
  email          String?
  upiId          String?  @map("upi_id")
  amount         Decimal  @db.Decimal(10, 2)
  tripsCompleted Int?     @default(1) @map("trips_completed")
  status         String?  @default("completed")
  createdAt      DateTime @default(now()) @map("created_at")

  rider Rider? @relation(fields: [riderId], references: [riderId], onDelete: SetNull)

  @@index([riderId])
  @@index([status])
  @@index([createdAt])
  @@map("rider_payouts")
}

model UserAddress {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  label         String?  @default("Home")
  receiverName  String   @map("receiver_name")
  phone         String
  streetAddress String   @map("street_address")
  landmark      String?
  city          String?  @default("Bengaluru")
  state         String?  @default("Karnataka")
  pincode       String?  @default("560001")
  latitude      Decimal? @db.Decimal(10, 6)
  longitude     Decimal? @db.Decimal(10, 6)
  isDefault     Boolean? @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Rating {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  userId          Int      @map("user_id")
  riderId         String?  @map("rider_id")
  productId       Int?     @map("product_id")
  riderRating     Int?     @map("rider_rating")
  productRating   Int?     @map("product_rating")
  riderFeedback   String?  @map("rider_feedback")
  productFeedback String?  @map("product_feedback")
  createdAt       DateTime @default(now()) @map("created_at")

  order Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rider Rider? @relation(fields: [riderId], references: [riderId], onDelete: SetNull)

  @@index([orderId])
  @@index([userId])
  @@index([riderId])
  @@map("ratings")
}

model Coupon {
  id                Int       @id @default(autoincrement())
  code              String    @unique
  discountType      String?   @default("percentage") @map("discount_type")
  discountValue     Decimal   @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount    Decimal?  @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(10, 2)
  expiryDate        DateTime? @map("expiry_date")
  usageLimit        Int?      @default(1000) @map("usage_limit")
  usedCount         Int?      @default(0) @map("used_count")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([active])
  @@map("coupons")
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  productId     Int?     @map("product_id")
  vendorId      Int?     @map("vendor_id")
  productName   String   @map("product_name")
  vendorName    String?  @map("vendor_name")
  warehouseName String?  @default("Central Dark Store Hub") @map("warehouse_name")
  warehouseCity String?  @map("warehouse_city")
  quantity      Decimal? @default(100) @db.Decimal(10, 2)
  unit          String?  @default("kg")
  status        String?  @default("in_stock")
  notes         String?
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  createdAt     DateTime @default(now()) @map("created_at")

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([vendorId])
  @@index([status])
  @@map("inventory")
}

model SupportTicket {
  id              Int       @id @default(autoincrement())
  ticketId        String?   @unique @map("ticket_id")
  role            String?   @default("user")
  senderName      String    @map("sender_name")
  senderEmail     String    @map("sender_email")
  senderPhone     String?   @map("sender_phone")
  category        String
  orderId         String?   @map("order_id")
  subject         String
  message         String
  priority        String?   @default("NORMAL")
  status          String    @default("OPEN")
  resolutionNotes String?   @map("resolution_notes")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([senderEmail])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("support_tickets")
}

model MonitoringAlert {
  id          Int      @id @default(autoincrement())
  serviceName String   @map("service_name")
  severity    String
  message     String
  resolved    Boolean  @default(false)
  timestamp   DateTime @default(now())

  @@index([severity])
  @@index([serviceName])
  @@index([timestamp])
  @@map("monitoring_alerts")
}
