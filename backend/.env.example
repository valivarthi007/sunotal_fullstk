# ── MERN Database (AWS DocumentDB / MongoDB Atlas Free Tier) ───────────
MONGODB_URI=mongodb://127.0.0.1:27017/sunotal
# MONGODB_URI=mongodb://sunotaladmin:sunotalpass123@docdb-cluster-endpoint.docdb.amazonaws.com:27017/sunotal?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# ── Caching ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=sunotal-change-this-secret-before-deploying-to-production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Payment & Map Providers ───────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
MAP_PROVIDER=cartodb
