pipeline {
  agent any

  environment {
    NODE_VERSION   = '20'
    PNPM_VERSION   = '9.15.4'
    AWS_REGION     = 'us-east-1'
    S3_BUCKET_NAME = 'jcs-raju-sunotal-final'
  }

  options {
    timestamps()
    timeout(time: 45, unit: 'MINUTES')
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install & Validate Code') {
      steps {
        dir('frontend') {
          sh 'npx --yes pnpm@${PNPM_VERSION} install --frozen-lockfile'
          sh 'npx --yes pnpm@${PNPM_VERSION} exec tsc --noEmit'
        }
        dir('backend') {
          sh 'npx --yes pnpm@${PNPM_VERSION} install --frozen-lockfile'
          sh 'npx --yes pnpm@${PNPM_VERSION} exec tsc --noEmit'
        }
      }
    }

    stage('Build & Package Artifacts') {
      steps {
        sh '''
          set -e
          cd frontend && npx --yes pnpm@${PNPM_VERSION} build
          cd ../backend && npx --yes pnpm@${PNPM_VERSION} build
          cd ..
          mkdir -p dist/artifacts
          tar -czf dist/artifacts/frontend-build.tgz -C frontend dist
          tar -czf dist/artifacts/backend-build.tgz -C backend dist package.json drizzle.config.ts src/schema src/db
        '''
      }
    }

    stage('Upload Build Artifacts to S3') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'AWS', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            set -e
            echo "Uploading artifacts to s3://${S3_BUCKET_NAME}/artifacts/latest/..."
            aws s3 cp dist/artifacts/frontend-build.tgz s3://${S3_BUCKET_NAME}/artifacts/latest/frontend-build.tgz
            aws s3 cp dist/artifacts/backend-build.tgz s3://${S3_BUCKET_NAME}/artifacts/latest/backend-build.tgz
          '''
        }
      }
    }

    stage('Deploy to Private EC2 via Bastion Host') {
      steps {
        withCredentials([
          usernamePassword(credentialsId: 'AWS', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
          sshUserPrivateKey(credentialsId: 'EC2_SSH_KEY', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER')
        ]) {
          sh '''
            set -e
            BASTION_IP=$(aws ec2 describe-instances \
              --filters "Name=tag:Name,Values=sunotal-bastion" "Name=instance-state-name,Values=running" \
              --query "Reservations[0].Instances[0].PublicIpAddress" --output text)

            PRIVATE_IP=$(aws ec2 describe-instances \
              --filters "Name=tag:Name,Values=sunotal-frontend" "Name=instance-state-name,Values=running" \
              --query "Reservations[0].Instances[0].PrivateIpAddress" --output text)

            DB_HOST=$(aws rds describe-db-instances \
              --db-instance-identifier "sunotal-postgres" \
              --query "DBInstances[0].Endpoint.Address" --output text || echo "")

            if [ -z "$BASTION_IP" ] || [ "$BASTION_IP" = "None" ] || [ -z "$PRIVATE_IP" ] || [ "$PRIVATE_IP" = "None" ]; then
              echo "::error::Bastion or Private EC2 instance IP not found. Ensure infrastructure is provisioned."
              exit 1
            fi

            mkdir -p ~/.ssh
            cp $SSH_KEY ~/.ssh/id_rsa
            chmod 600 ~/.ssh/id_rsa

            cat <<EOF > ~/.ssh/config
            Host bastion
              HostName ${BASTION_IP}
              User ubuntu
              IdentityFile ~/.ssh/id_rsa
              StrictHostKeyChecking no

            Host app-private
              HostName ${PRIVATE_IP}
              User ubuntu
              IdentityFile ~/.ssh/id_rsa
              ProxyJump bastion
              StrictHostKeyChecking no
            EOF
            chmod 600 ~/.ssh/config

            echo "Executing remote deployment over SSH ProxyJump..."
            ssh app-private bash -s <<REMOTE_DEPLOY
              set -e
              export PATH=\$PATH:/usr/local/bin:/usr/bin:/bin:/snap/bin:~/.local/share/pnpm
              export NODE_OPTIONS='--max-old-space-size=2048'

              echo "Ensuring 2GB swap file exists on EC2 instance..."
              if [ ! -f /swapfile ]; then
                sudo fallocate -l 2G /swapfile || sudo dd if=/dev/zero of=/swapfile bs=1M count=2048
                sudo chmod 600 /swapfile
                sudo mkswap /swapfile
                sudo swapon /swapfile
              fi

              mkdir -p /tmp/sunotal-artifacts
              aws s3 cp s3://${S3_BUCKET_NAME}/artifacts/latest/frontend-build.tgz /tmp/sunotal-artifacts/frontend-build.tgz
              aws s3 cp s3://${S3_BUCKET_NAME}/artifacts/latest/backend-build.tgz /tmp/sunotal-artifacts/backend-build.tgz

              sudo mkdir -p /var/www/sunotal && sudo rm -rf /var/www/sunotal/*
              sudo tar -xzf /tmp/sunotal-artifacts/frontend-build.tgz -C /var/www/sunotal/

              sudo mkdir -p /var/www/sunotal-backend && sudo rm -rf /var/www/sunotal-backend/*
              sudo tar -xzf /tmp/sunotal-artifacts/backend-build.tgz -C /var/www/sunotal-backend/
              sudo chown -R ubuntu:www-data /var/www/sunotal /var/www/sunotal-backend

              cd /var/www/sunotal-backend
              if [ -n "${DB_HOST}" ] && [ "${DB_HOST}" != "None" ]; then
                echo "DATABASE_URL=postgresql://sunotal:sunotalpass123@${DB_HOST}:5432/sunotal" > .env
              else
                cp -n .env.example .env || true
              fi

              pnpm install || npx --yes pnpm@${PNPM_VERSION} install
              pnpm run db:push || npx --yes pnpm@${PNPM_VERSION} run db:push
              (pnpm run db:seed || npx --yes pnpm@${PNPM_VERSION} run db:seed || true)

              (pm2 restart sunotal-backend --update-env || pm2 start dist/src/index.js --name sunotal-backend)
              sudo env PATH=\$PATH:/usr/bin pm2 startup systemd -u ubuntu --hp /home/ubuntu || true
              pm2 save || true

              sudo systemctl enable nginx && sudo systemctl restart nginx
              rm -rf /tmp/sunotal-artifacts
              echo "✅ Remote application deployment completed successfully!"
REMOTE_DEPLOY
          '''
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'dist/artifacts/**', allowEmptyArchive: true
      cleanWs()
    }
    success {
      echo '✅ Deployment pipeline completed successfully.'
    }
    failure {
      echo '❌ Deployment pipeline failed. Please review execution logs.'
    }
  }
}
